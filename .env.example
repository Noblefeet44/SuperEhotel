# Supabase Configuration
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Admin auth — set this to a strong secret for session management
ADMIN_JWT_SECRET=super-e-hotel-admin-secret-change-this
ADMIN_EMAIL=admin@superehotel.com
ADMIN_PASSWORD=change-in-production

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Super E Luxury Hotel <onboarding@resend.dev>"
RESEND_ADMIN_EMAIL=admin@superehotel.com

